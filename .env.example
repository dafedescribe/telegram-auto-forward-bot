# Copy to .env (local only, never commit). GitHub Actions uses repo Secrets instead.
# Get API_ID / API_HASH at https://my.telegram.org -> API development tools.
API_ID=your_api_id
API_HASH=your_api_hash
# Comma-separated numeric chat IDs. Find yours with: python forwarder.py --list-groups
SOURCE_CHATS=-1001234567890,-1009876543210
# Webhook that receives JSON chunks of email-containing messages.
DESTINATION_URL=https://example.com/webhook
# Generate with: python forwarder.py --export-session (interactive login, then paste output)
SESSION_STRING=
# Hourly Actions run uses LOOKBACK_HOURS=1; local testing can use 24.
LOOKBACK_HOURS=24
MAX_BACKFILL=50
CHUNK_SIZE=10
LOG_FILE=forwarder.log
# 1 = forward only remote/hybrid roles (drops on-site posts); 0 = all posts with email.
REMOTE_ONLY=1
